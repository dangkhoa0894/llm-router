# Used by docker-compose.yml to configure the Postgres container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=llm_router
POSTGRES_PORT=5432

# Used by Prisma / the app when run from the host (npm run dev, prisma migrate).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/llm_router?schema=public"

# Host port the `app` service is published on (container always listens on 3000)
APP_PORT=3000

# Bearer token for the operator API at /api/admin/* (disabled if empty)
ROUTER_ADMIN_TOKEN=""
# Self-serve signup at POST /api/signup, and free credit granted on it
ROUTER_SIGNUP_ENABLED="false"
ROUTER_SIGNUP_CREDIT_USD="0"
# Markup over upstream cost used by `npm run seed` (0.2 = +20%)
ROUTER_DEFAULT_MARKUP="0.2"

# Upstream provider keys. Each provider row names the env var it reads;
# deployments on providers without a key set are skipped.
DEEPINFRA_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""
TOGETHER_API_KEY=""

# --- VietQR bank-transfer top-ups (disabled unless BANK_BIN + ACCOUNT_NO set)
# 6-digit NAPAS BIN of the receiving bank, e.g. 970422 MB Bank, 970436 Vietcombank,
# 970407 Techcombank, 970418 BIDV, 970415 VietinBank, 970416 ACB
VIETQR_BANK_BIN=""
VIETQR_BANK_NAME=""
VIETQR_ACCOUNT_NO=""
VIETQR_ACCOUNT_NAME=""
# Rate used to convert a VND transfer into USD credit (locked per order)
VIETQR_VND_PER_USD="26000"
VIETQR_MIN_VND="10000"
VIETQR_MAX_VND="50000000"
VIETQR_ORDER_TTL_MINUTES="30"
# Transfer memo prefix; memos look like LLMR7K2Q9XTA
TOPUP_CODE_PREFIX="LLMR"
# API key configured on the SePay webhook (sent as `Authorization: Apikey <key>`)
SEPAY_WEBHOOK_API_KEY=""
